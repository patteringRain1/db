/*

TimeProvinceProductCountSum : Table agrégée par time, province et product. Elle stocke déjà le nombre 
d’achats et la quantité totale. Elle sert surtout à q1, q2, q3, q5, q6 et q10.

*/
DROP TABLE IF EXISTS TimeProvinceProductCountSum; 

CREATE TABLE TimeProvinceProductCountSum as 
select 
    time,
    province, 
    product,
    COUNT(*) as purchase_count, 
    SUM(qty) as total_qty
FROM Purchases
GROUP BY time, province, product;


/*
TimeProvinceQty : Table agrégée par time, province et qty. Elle sert surtout à q4 et q9,
car ces deux requêtes regroupent les achats par continent et par quantité achetée.
*/
DROP TABLE IF EXISTS TimeProvinceQty;

create table TimeProvinceQty as 
select 
time,
province,
qty,
count(*) as purchase_count
from Purchases 
where qty between 1 and 10
group by time, province, qty;