/*
pur_time_index : Index sur Purchases(time). Il aide les requêtes qui cherchent 
les derniers jours ou le dernier jour présent dans la base.
*/
CREATE INDEX pur_time_index ON Purchases(time);


/* ProvinceCountry : Table auxiliaire qui fait le lien entre province et pays. 
Elle évite de refaire souvent le join entre Province et Country

province_country_index : Index sur ProvinceCountry(province_id). 
Il rend le join entre les achats et ProvinceCountry plus rapide.
*/
DROP TABLE IF EXISTS ProvinceCountry;

CREATE TABLE ProvinceCountry as 
select 
    pro.rowid as province_id, 
    pro.name as province_name, 
    cty.code as country_code,
    cty.name as country_name
from Province as pro 
join Country as cty
on cty.code = pro.country;

CREATE INDEX province_country_index on ProvinceCountry(province_id);


/*
purchases_time_province_index : Index sur Purchases(time, province). Il aide surtout les requêtes 
qui filtrent par temps puis par province, comme q7 et q8.
*/
CREATE INDEX purchases_time_province_index ON Purchases(time, province);




