/*
QUERIES DONT CONSIDER TIME
*/

/* 1) Determine the 10 countries with the most purchases; list the names of these countries, as well
as the number of purchases; sort the results in decreasing order of purchases.
*/

select c.name, Count(pur.id) as cnt
from Purchases as pur
join Province as pro on pur.province = pro.rowid
join Country as c on c.code = pro.country
group by c.name
order by cnt desc 
limit 10;

/*
Version optimisée


On utilise TimeProvinceProductCountSum pour ne plus compter toutes les 
lignes de Purchases. On additionne directement purchase_count.
On utilise aussi ProvinceCountry pour éviter de refaire le join Province - Country.
*/

select prov.country_name, 
SUM(t.purchase_count) as cnt
from TimeProvinceProductCountSum AS t
JOIN ProvinceCountry AS prov
ON t.province = prov.province_id
Group by prov.country_name
order by cnt desc
limit 10;



/* 2) Determine the total number of purchases for each product. List the number of the product, as
well as the total number of purchases.
*/

select pur.product, Count(pur.id) as cnt
from Purchases as pur
group by pur.product;

/*
Version optimisée

On remplace count sur Purchases par SUM(purchase_count) 
sur TimeProvinceProductCountSum. Cela évite de parcourir toute la table des achats.
*/

SELECT product, SUM(purchase_count) as cnt
from TimeProvinceProductCountSum 
group by product; 


/* 3) Determine for each country the province in which the total number of purchases of product
0 is the highest; list the name of the country, the name of the province, and the number of
purchases, both absolute and as a proportion of the total number of purchases in that country
*/

With ProvinceCounts AS (
-- on compte le nombre d'achats du produit 0 pour chaque province
    select c.name as country, pro.name as province, COUNT(pur.id) as cnt
    from Purchases as pur
    join Province as pro on pro.rowid = pur.province
    join Country as c on c.code = pro.country
    where pur.product = 0
    group by c.name, pro.name),
CountryTotals AS (
-- on compte le nombre d'achats du produit ° pour chaque pays
    select country, SUM(cnt) as total_cnt
    from ProvinceCounts
    group by country)
-- on assemble le tout pour trouver le max et calcul la proportion
    select pc.country, pc.province, MAX(pc.cnt) as abs, CAST(MAX(pc.cnt) as FLOAT) / ct.total_cnt as prop
    from ProvinceCounts as pc
    join CountryTotals as ct on ct.country = pc.country
    group by pc.country;


/*
Version optimisée


On utilise TimeProvinceProductCountSum pour obtenir plus vite le nombre d’achats 
du produit 0 par province. ProvinceCountry permet d’obtenir directement 
le nom du pays et de la province.
*/

WITH ProvinceCounts AS (
    select 
    prov.country_name as country,
    prov.province_name as province, 
    SUM(t.purchase_count) as cnt
    from TimeProvinceProductCountSum as t
    join ProvinceCountry as prov
    on t.province = prov.province_id
    where t.product = 0
    group by prov.country_name, prov.province_name

),
CountryTotals AS (
    select country, SUM(cnt) as total_cnt
    from ProvinceCounts
    group by country)
    select pc.country, pc.province, MAX(pc.cnt) as abs, CAST(MAX(pc.cnt) as FLOAT) / ct.total_cnt as prop
    from ProvinceCounts as pc
    join CountryTotals as ct on ct.country = pc.country
    group by pc.country;




    
/* 4) List for each continent and each possible number of items per purchase (in the range 1...10),
the corresponding number of purchases. Only consider countries that are 100% located in their
respective continents.
*/

select e.continent as name, pur.qty, Count(pur.id) as cnt
from Purchases as pur
join Province as pro on pro.rowid = pur.province
join Country as c on c.code = pro.country
join Encompasses as e on e.country = c.code
where pur.qty BETWEEN 1 AND 10 and e.percentage = 100
group by e.continent, pur.qty;

/*
Version optimisée

On utilise TimeProvinceQty, qui contient déjà le nombre d’achats par jour,
province et quantité. On évite donc de recompter directement dans Purchases. 
ProvinceCountry est utilisé pour rejoindre plus facilement avec Encompasses.
*/

select e.continent as name, t.qty, SUM(t.purchase_count) AS cnt
from TimeProvinceQty as t

join ProvinceCountry as pc
on t.province = pc.province_id

join Encompasses AS e 
on e.country = pc.country_code

where e.percentage = 100

group by e.continent, t.qty;


/*
QUERIES THAT CONSIDER THE LAST TEN DAYS
*/


/* 5) Determine the total number of purchases for each product. List the number of the product, as
well as the total number of purchases
*/


/*   old CHUQUI
select pur.product, Count(pur.id) as cnt
from Purchases as pur 
group by pur.product;
*/

WITH LastTenDays AS (
    SELECT DISTINCT time 
    from Purchases
    order by time DESC
    limit 10
)

SELECT pur.product, count(*) as cnt
from Purchases as pur
where pur.time in (
    select time 
    from LastTenDays
)
group by pur.product;


/*
Version optimisée

Même idée que q2, mais seulement pour les 10 derniers jours. 
On utilise TimeProvinceProductCountSum et on additionne purchase_count.
*/

WITH LastTenDays AS (
    SELECT DISTINCT time 
    from TimeProvinceProductCountSum
    order by time DESC
    limit 10
)
SELECT product, SUM(purchase_count) as cnt
from TimeProvinceProductCountSum 
WHERE time IN (
    select time 
    from LastTenDays
)
group by product;



/* 6)
Determine the total number of purchases for each of the last ten days. List the date, as well as
the total number of purchases.*/

select time, Count(id) as cnt
from Purchases
group by time
order by time desc
limit 10;

/*
Version optimisée

On utilise TimeProvinceProductCountSum pour calculer le nombre d’achats par jour avec 
SUM(purchase_count), au lieu de compter les lignes de Purchases.

*/

select time, SUM(purchase_count) as cnt
from TimeProvinceProductCountSum 
group by time
order by time desc
limit 10;


