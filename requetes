/* 9)
List for each continent and each possible number of items per purchase (in the range 1...10),
the corresponding number of purchases. Only consider countries that are 100% located in their
respective continents. Note that the difference with the earlier question is that we only consider
the last 10 days.*/

WITH LastTenDays AS (
    select time
    from Purchases 
    group by time 
    order by time desc 
    limit 10
)
select 
    e.continent as name, 
    pur.qty, 
    COUNT(pur.id) as cnt
from Purchases as pur
join Province as pro on pur.province = pro.rowid
join Country as c on c.code = pro.country
join Encompasses as e on e.country = c.code
where pur.qty between 1 and 10
  and e.percentage = 100
  and pur.time in (select time from LastTenDays)
group by e.continent, pur.qty;

/*
Version optimisée

On utilise TimeProvinceQty, comme pour q4, mais en filtrant seulement les 
10 derniers jours. Cela évite de regrouper directement les achats individuels.

*/

WITH LastTenDays AS (
    select distinct time
    from TimeProvinceQty
    order by time desc 
    limit 10
)

select 
    e.continent as name, 
    t.qty,
    sum(t.purchase_count) as cnt 
from TimeProvinceQty as t
join ProvinceCountry as pc
on t.province = pc.province_id

join Encompasses as e
on e.country = pc.country_code

where e.percentage = 100

and t.time in (
    select time 
    from LastTenDays
)

Group by e.continent, t.qty;



/*
QUERY THAT INVOLVES TIMES

*/
/*  10)
List the top-10 of provinces for which the difference between the total number of items in
purchases of the last 10 days and the preceding period of 10 days is the largest (i.e., the
increase is large; we do not look for the largest decreases); list the full name of the province,
the full name of the country, and the number of purchases in the last 10 days, as well as in the
preceding period of 10 days; order the results by the size of the difference. Note that if there is
no preceding period, the outcome is supposed to be empty
*/

WITH RecentDays AS (
    select time
    from Purchases 
    group by time 
    order by time desc 
    limit 20
),
Last10 AS (
    select time 
    from RecentDays 
    limit 10
),
Prec10 AS (
    select time
    from RecentDays 
    limit 10 
    offset 10
),
Stats AS (
    select pur.province,
        SUM(case when pur.time in (select time from Last10) then pur.qty else 0 end) as items_last,
        SUM(case when pur.time in (select time from Prec10) then pur.qty else 0 end) as items_prec,
        COUNT(case when pur.time in (select time from Last10) then pur.id end) as pur_last,
        COUNT(case when pur.time in (select time from Prec10) then pur.id end) as pur_prec
    from Purchases as pur
    where pur.time in (select time from RecentDays)
    group by pur.province
)
select pro.name as province, c.name as country, s.pur_last as qty_last10, s.pur_prec as qty_1020
from Stats as s
join Province as pro on s.province = pro.rowid
join Country as c on c.code = pro.country
where (select COUNT(*) from Prec10) > 0 
and (s.items_last - s.items_prec) > 0
order by (s.items_last - s.items_prec) desc
limit 10;


/*
Version optimisée

On utilise TimeProvinceProductCountSum pour comparer les quantités vendues 
dans les 10 derniers jours et les 10 jours précédents.
Au lieu de faire SUM(qty) sur Purchases, on fait SUM(total_qty) sur une table déjà agrégée.
*/


WITH RecentDays AS (
    select time
    from Purchases 
    group by time 
    order by time desc 
    limit 20
),
Last10 AS (
    select time 
    from RecentDays 
    limit 10
),
Prec10 AS (
    select time
    from RecentDays 
    limit 10 
    offset 10
),
Stats AS (
    select t.province,
        SUM(case when t.time in (select time from Last10) then t.total_qty else 0 end) as items_last,
        SUM(case when t.time in (select time from Prec10) then t.total_qty else 0 end) as items_prec,
        SUM(case when t.time in (select time from Last10) then t.purchase_count else 0 end) as pur_last,
        SUM(case when t.time in (select time from Prec10) then t.purchase_count else 0 end) as pur_prec
    from TimeProvinceProductCountSum  as t
    where t.time in (select time from RecentDays)
    group by t.province
)
select pro.name as province, c.name as country, s.pur_last as qty_last10, s.pur_prec as qty_1020
from Stats as s
join Province as pro on s.province = pro.rowid
join Country as c on c.code = pro.country
where (select COUNT(*) from Prec10) > 0 
and (s.items_last - s.items_prec) > 0
order by (s.items_last - s.items_prec) desc
limit 10;




